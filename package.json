{
  "name": "pastel-cutout-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "render:short": "node scripts/render.mjs Short",
    "render:long": "node scripts/render.mjs Long",
    "render": "node scripts/render.mjs",
    "render:stills": "node scripts/render.mjs Short Long --stills",
    "narration": "python3 scripts/narration.py"
  },
  "dependencies": {
    "@remotion/animation-utils": "4.0.538",
    "@remotion/bundler": "4.0.538",
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "4.0.538",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/sfx": "4.0.538",
    "@remotion/shapes": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "p5.brush": "3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "eslint": "10.13.0",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  },
  "overrides": {
    "zod": "4.5.4"
  }
}
