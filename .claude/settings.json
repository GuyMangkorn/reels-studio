{
  "permissions": {
    "deny": ["mcp__Claude_Code_iOS_Simulator__*"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/agent-run-log.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
