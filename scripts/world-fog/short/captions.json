{
 "episode": "WFOG-EP01-SHORT",
 "fps": 30,
 "cues": [
  {
   "id": "VO-01-1",
   "line": "VO-01",
   "startG": 0,
   "endG": 29,
   "text": "มันตามฉันมา"
  },
  {
   "id": "VO-02-1",
   "line": "VO-02",
   "startG": 83,
   "endG": 126,
   "text": "ฉันเห็นมันตอนเลี้ยวเข้าปั๊ม"
  },
  {
   "id": "VO-02-2",
   "line": "VO-02",
   "startG": 126,
   "endG": 171,
   "text": "ตอนนั้นแค่คิดว่าจะเติมน้ำมัน…"
  },
  {
   "id": "VO-02-3",
   "line": "VO-02",
   "startG": 171,
   "endG": 190,
   "text": "แล้วกลับบ้าน"
  },
  {
   "id": "VO-03-1",
   "line": "VO-03",
   "startG": 293,
   "endG": 316,
   "text": "แต่พอเข้าร้าน"
  },
  {
   "id": "VO-03-2",
   "line": "VO-03",
   "startG": 316,
   "endG": 354,
   "text": "หมอกก็กลืนลานจอดจนหมด"
  },
  {
   "id": "VO-03-3",
   "line": "VO-03",
   "startG": 354,
   "endG": 376,
   "text": "ข่าวในมือถือ…"
  },
  {
   "id": "VO-03-4",
   "line": "VO-03",
   "startG": 376,
   "endG": 408,
   "text": "ก็มีแต่ภาพเดียวกัน"
  },
  {
   "id": "VO-04-1",
   "line": "VO-04",
   "startG": 468,
   "endG": 494,
   "text": "ใครอยู่ตรงนั้น?"
  },
  {
   "id": "VO-05-1",
   "line": "VO-05",
   "startG": 583,
   "endG": 627,
   "text": "เงานั้นกำลังมาทางเรา"
  },
  {
   "id": "VO-05-2",
   "line": "VO-05",
   "startG": 627,
   "endG": 668,
   "text": "สูงเกือบถึงขอบประตู…"
  },
  {
   "id": "VO-05-3",
   "line": "VO-05",
   "startG": 668,
   "endG": 738,
   "text": "แล้วมีเสียงอะไรครูดพื้นตามมาด้วย"
  },
  {
   "id": "VO-06-1",
   "line": "VO-06",
   "startG": 810,
   "endG": 857,
   "text": "ตัวเดียวกับที่ฉันเห็นข้างถนน"
  },
  {
   "id": "VO-07-1",
   "line": "VO-07",
   "startG": 1047,
   "endG": 1078,
   "text": "อย่าเปิดนะ"
  },
  {
   "id": "VO-08-1",
   "line": "VO-08",
   "startG": 1101,
   "endG": 1120,
   "text": "เงียบก่อน…"
  },
  {
   "id": "VO-08-2",
   "line": "VO-08",
   "startG": 1124,
   "endG": 1158,
   "text": "มันอาจยังไม่เห็นเรา"
  },
  {
   "id": "VO-09-1",
   "line": "VO-09",
   "startG": 1446,
   "endG": 1479,
   "text": "เดี๋ยว… นั่นหัวมันเหรอ?"
  },
  {
   "id": "VO-10-1",
   "line": "VO-10",
   "startG": 1544,
   "endG": 1569,
   "text": "มีใครอยู่ไหมครับ?"
  },
  {
   "id": "VO-10-2",
   "line": "VO-10",
   "startG": 1574,
   "endG": 1589,
   "text": "ช่วยหน่อย!"
  },
  {
   "id": "VO-10-3",
   "line": "VO-10",
   "startG": 1599,
   "endG": 1633,
   "text": "ผมจับไว้ไม่ไหวแล้ว!"
  },
  {
   "id": "VO-11-1",
   "line": "VO-11",
   "startG": 1680,
   "endG": 1723,
   "text": "ฉันค่อย ๆ ยกไฟฉายขึ้น"
  },
  {
   "id": "VO-12-1",
   "line": "VO-12",
   "startG": 1866,
   "endG": 1880,
   "text": "คนส่งของ…"
  },
  {
   "id": "VO-12-2",
   "line": "VO-12",
   "startG": 1880,
   "endG": 1922,
   "text": "กำลังประคองกล่องบนรถเข็น"
  },
  {
   "id": "VO-12-3",
   "line": "VO-12",
   "startG": 1922,
   "endG": 1959,
   "text": "ข้างบนเป็นหมวกกันน็อก"
  },
  {
   "id": "VO-12-4",
   "line": "VO-12",
   "startG": 1959,
   "endG": 1994,
   "text": "ที่เคาะกระจกเมื่อกี้…"
  },
  {
   "id": "VO-12-5",
   "line": "VO-12",
   "startG": 1994,
   "endG": 2009,
   "text": "ก็ด้ามร่ม"
  },
  {
   "id": "VO-13-1",
   "line": "VO-13",
   "startG": 2089,
   "endG": 2137,
   "text": "ในหมอกแบบนี้ ตาเห็นแค่บางส่วน…"
  },
  {
   "id": "VO-13-2",
   "line": "VO-13",
   "startG": 2137,
   "endG": 2190,
   "text": "สมองเราก็มักจะเติมส่วนที่ขาดเอง"
  },
  {
   "id": "VO-13-3",
   "line": "VO-13",
   "startG": 2190,
   "endG": 2265,
   "text": "แล้วความกลัว ก็ชวนให้ฉันมองว่ามันเป็นอันตราย"
  },
  {
   "id": "VO-14-1",
   "line": "VO-14",
   "startG": 2357,
   "endG": 2402,
   "text": "คุณมาจากถนนใหญ่ใช่ไหมคะ?"
  },
  {
   "id": "VO-14-2",
   "line": "VO-14",
   "startG": 2413,
   "endG": 2447,
   "text": "ข้างนอกเป็นยังไงบ้าง?"
  },
  {
   "id": "VO-15-1",
   "line": "VO-15",
   "startG": 2462,
   "endG": 2530,
   "text": "รถชนกันขวางถนนครับ"
  },
  {
   "id": "VO-15-2",
   "line": "VO-15",
   "startG": 2539,
   "endG": 2556,
   "text": "รถผมติดอยู่ข้างหลังนั่น"
  },
  {
   "id": "VO-15-3",
   "line": "VO-15",
   "startG": 2565,
   "endG": 2609,
   "text": "เลยต้องเข็นของมาส่งร้านนี้เอง…"
  },
  {
   "id": "VO-15-4",
   "line": "VO-15",
   "startG": 2622,
   "endG": 2670,
   "text": "แต่ตอนนี้ กลับทางเดิมไม่ได้แล้ว"
  },
  {
   "id": "VO-16-1",
   "line": "VO-16",
   "startG": 2790,
   "endG": 2835,
   "text": "สิ่งที่ฉันกลัวเมื่อกี้…"
  },
  {
   "id": "VO-16-2",
   "line": "VO-16",
   "startG": 2835,
   "endG": 2868,
   "text": "เป็นแค่คนคนหนึ่ง"
  },
  {
   "id": "VO-16-3",
   "line": "VO-16",
   "startG": 2868,
   "endG": 2911,
   "text": "แต่หมอกนี่ยังไม่ไปไหน…"
  },
  {
   "id": "VO-16-4",
   "line": "VO-16",
   "startG": 2911,
   "endG": 2951,
   "text": "แล้วเราก็ไปไหนไม่ได้"
  }
 ],
