 ],
 "captions": [
  {
   "id": "VO-01-1",
   "line": "VO-01",
   "g0": 0,
   "g1": 42,
   "text": "มันตามฉันมา"
  },
  {
   "id": "VO-02-1",
   "line": "VO-02",
   "g0": 48,
   "g1": 104,
   "text": "ฉันเห็นมันตอนเลี้ยวเข้าปั๊ม"
  },
  {
   "id": "VO-02-2",
   "line": "VO-02",
   "g0": 132,
   "g1": 187,
   "text": "ตอนนั้นแค่คิดว่าจะเติมน้ำมัน…"
  },
  {
   "id": "VO-02-3",
   "line": "VO-02",
   "g0": 187,
   "g1": 207,
   "text": "แล้วกลับบ้าน"
  },
  {
   "id": "VO-03-1",
   "line": "VO-03",
   "g0": 386,
   "g1": 434,
   "text": "แต่พอเข้าร้าน"
  },
  {
   "id": "VO-03-2",
   "line": "VO-03",
   "g0": 439,
   "g1": 502,
   "text": "หมอกก็กลืนลานจอดจนหมด"
  },
  {
   "id": "VO-03-3",
   "line": "VO-03",
   "g0": 648,
   "g1": 700,
   "text": "ข่าวในมือถือ…"
  },
  {
   "id": "VO-03-4",
   "line": "VO-03",
   "g0": 708,
   "g1": 754,
   "text": "ก็มีแต่ภาพเดียวกัน"
  },
  {
   "id": "VO-04-1",
   "line": "VO-04",
   "g0": 810,
   "g1": 842,
   "text": "ใครอยู่ตรงนั้น?"
  },
  {
   "id": "VO-05-1",
   "line": "VO-05",
   "g0": 900,
   "g1": 965,
   "text": "เงานั้นกำลังมาทางเรา"
  },
  {
   "id": "VO-05-2",
   "line": "VO-05",
   "g0": 973,
   "g1": 1025,
   "text": "สูงเกือบถึงขอบประตู…"
  },
  {
   "id": "VO-05-3",
   "line": "VO-05",
   "g0": 1055,
   "g1": 1123,
   "text": "แล้วมีเสียงอะไรครูดพื้นตามมาด้วย"
  },
  {
   "id": "VO-06-1",
   "line": "VO-06",
   "g0": 1152,
   "g1": 1215,
   "text": "ตัวเดียวกับที่ฉันเห็นข้างถนน"
  },
  {
   "id": "VO-07-1",
   "line": "VO-07",
   "g0": 1389,
   "g1": 1424,
   "text": "อย่าเปิดนะ"
  },
  {
   "id": "VO-08-1",
   "line": "VO-08",
   "g0": 1443,
   "g1": 1484,
   "text": "เงียบก่อน…"
  },
  {
   "id": "VO-08-2",
   "line": "VO-08",
   "g0": 1488,
   "g1": 1527,
   "text": "มันอาจยังไม่เห็นเรา"
  },
  {
   "id": "VO-09-1",
   "line": "VO-09",
   "g0": 1780,
   "g1": 1847,
   "text": "เดี๋ยว… นั่นหัวมันเหรอ?"
  },
  {
   "id": "VO-10-1",
   "line": "VO-10",
   "g0": 1872,
   "g1": 1901,
   "text": "มีใครอยู่ไหมครับ?"
  },
  {
   "id": "VO-10-2",
   "line": "VO-10",
   "g0": 1901,
   "g1": 1934,
   "text": "ช่วยหน่อย!"
  },
  {
   "id": "VO-10-3",
   "line": "VO-10",
   "g0": 1934,
   "g1": 1990,
   "text": "ผมจับไว้ไม่ไหวแล้ว!"
  },
  {
   "id": "VO-11-1",
   "line": "VO-11",
   "g0": 2022,
   "g1": 2085,
   "text": "ฉันค่อย ๆ ยกไฟฉายขึ้น"
  },
  {
   "id": "VO-12-1",
   "line": "VO-12",
   "g0": 2172,
   "g1": 2224,
   "text": "คนส่งของ…"
  },
  {
   "id": "VO-12-2",
   "line": "VO-12",
   "g0": 2232,
   "g1": 2300,
   "text": "กำลังประคองกล่องบนรถเข็น"
  },
  {
   "id": "VO-12-3",
   "line": "VO-12",
   "g0": 2307,
   "g1": 2346,
   "text": "ข้างบนเป็นหมวกกันน็อก"
  },
  {
   "id": "VO-12-4",
   "line": "VO-12",
   "g0": 2368,
   "g1": 2410,
   "text": "ที่เคาะกระจกเมื่อกี้…"
  },
  {
   "id": "VO-12-5",
   "line": "VO-12",
   "g0": 2412,
   "g1": 2446,
   "text": "ก็ด้ามร่ม"
  },
  {
   "id": "VO-13-1",
   "line": "VO-13",
   "g0": 2495,
   "g1": 2605,
   "text": "ในหมอกแบบนี้ ตาเห็นแค่บางส่วน…"
  },
  {
   "id": "VO-13-2",
   "line": "VO-13",
   "g0": 2610,
   "g1": 2698,
   "text": "สมองเราก็มักจะเติมส่วนที่ขาดเอง"
  },
  {
   "id": "VO-13-3",
   "line": "VO-13",
   "g0": 2718,
   "g1": 2827,
   "text": "แล้วความกลัว\nก็ชวนให้ฉันมองว่ามันเป็นอันตราย"
  },
  {
   "id": "VO-14-1",
   "line": "VO-14",
   "g0": 2924,
   "g1": 2980,
   "text": "คุณมาจากถนนใหญ่ใช่ไหมคะ?"
  },
  {
   "id": "VO-14-2",
   "line": "VO-14",
   "g0": 2983,
   "g1": 3021,
   "text": "ข้างนอกเป็นยังไงบ้าง?"
  },
  {
   "id": "VO-15-1",
   "line": "VO-15",
   "g0": 3044,
   "g1": 3110,
   "text": "รถชนกันขวางถนนครับ"
  },
  {
   "id": "VO-15-2",
   "line": "VO-15",
   "g0": 3110,
   "g1": 3170,
   "text": "รถผมติดอยู่ข้างหลังนั่น"
  },
  {
   "id": "VO-15-3",
   "line": "VO-15",
   "g0": 3170,
   "g1": 3253,
   "text": "เลยต้องเข็นของมาส่งร้านนี้เอง…"
  },
  {
   "id": "VO-15-4",
   "line": "VO-15",
   "g0": 3253,
   "g1": 3336,
   "text": "แต่ตอนนี้ กลับทางเดิมไม่ได้แล้ว"
  },
  {
   "id": "VO-17-1",
   "line": "VO-17",
   "g0": 3368,
   "g1": 3424,
   "text": "ของพวกนี้ลูกค้าสั่งไว้ครับ…"
  },
  {
   "id": "VO-17-2",
   "line": "VO-17",
   "g0": 3424,
   "g1": 3493,
   "text": "เขาบอกว่าจะมารับเองที่นี่"
  },
  {
   "id": "VO-16-1",
   "line": "VO-16",
   "g0": 3627,
   "g1": 3717,
   "text": "สิ่งที่ฉันกลัวเมื่อกี้…"
  },
  {
   "id": "VO-16-2",
   "line": "VO-16",
   "g0": 3721,
   "g1": 3765,
   "text": "เป็นแค่คนคนหนึ่ง"
  },
  {
   "id": "VO-16-3",
   "line": "VO-16",
   "g0": 3774,
   "g1": 3829,
   "text": "แต่หมอกนี่ยังไม่ไปไหน…"
  },
  {
   "id": "VO-16-4",
   "line": "VO-16",
   "g0": 3834,
   "g1": 3875,
   "text": "แล้วเราก็ไปไหนไม่ได้"
  }
 ]
}
