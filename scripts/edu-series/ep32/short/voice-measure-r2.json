   "frame_off": 1394,
   "dur": 1.7,
   "pauses": [
    [
     45.37,
     0.28
    ]
   ],
   "text": "แต่สรุปว่า… ใช้งานจริงไม่ได้"
  },
  {
   "line": "L13",
   "who": "NARR",
   "file_start": 47.09,
   "file_end": 52.62,
   "speech_on": 47.1,
   "speech_off": 52.55,
